msgstr "Прятать, когда всё в порядке"

msgid "The icon appears on its own while data is transferring, and is highlighted on sync errors, low space or an oversized cache."
msgstr "Значок появится сам при передаче данных и будет подсвечен при ошибках синхронизации, нехватке места или разросшемся кэше."

msgid "When to warn"
msgstr "Когда предупреждать"

msgid "Cloud storage used above, %:"
msgstr "Облако заполнено больше, %:"

msgid "FUSE cache larger than, MiB:"
msgstr "Кэш FUSE больше, МиБ:"

msgid "Polling interval"
msgstr "Частота опроса"

msgid "Panel open, s:"
msgstr "Панель раскрыта, с:"

msgid "Collapsed, on AC power, s:"
msgstr "Свёрнута, питание от сети, с:"

msgid "Collapsed, on battery, s:"
msgstr "Свёрнута, питание от батареи, с:"

msgid "The widget queries MEGAcmd on a timer only. The rarer the polling while collapsed, the less battery it uses."
msgstr "Виджет обращается к MEGAcmd только по таймеру. Чем реже опрос при свёрнутой панели, тем меньше расход батареи."

msgid "Updates paused"
msgstr "Обновление приостановлено"

msgid "%1 sync issue"
msgid_plural "%1 sync issues"
msgstr[0] "%1 проблема синхронизации"
msgstr[1] "%1 проблемы синхронизации"
msgstr[2] "%1 проблем синхронизации"

msgid "Sync error"
msgstr "Ошибка синхронизации"

msgid "Cloud storage almost full"
msgstr "Заканчивается место в облаке"

