msgid "General"
msgstr "Общие"

msgid "Could not clear the cache"
msgstr "Не удалось очистить кэш"

msgid "MEGAcmd is not installed"
msgstr "MEGAcmd не установлен"

msgid "MEGAcmd server is not responding"
msgstr "Сервер MEGAcmd не отвечает"

msgid "Not signed in"
msgstr "Не выполнен вход"

msgid "Install the megacmd package to use this widget."
msgstr "Установите пакет megacmd, чтобы виджет заработал."

msgid "Start mega-cmd-server or check the megacmd service."
msgstr "Запустите mega-cmd-server или проверьте службу megacmd."

msgid "Sign in with mega-cmd → login. This widget never asks for or stores your password."
msgstr "Выполните вход командой mega-cmd → login. Пароль виджет не запрашивает и не хранит."

msgid "Automatic updates are off. Data refreshes only on request."
msgstr "Автоматическое обновление выключено. Данные обновляются только по запросу."

